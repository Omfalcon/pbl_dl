# PhishVision AI — Environment Variables Template
# Copy this file to .env and insert your personal API keys if available.
# Note: .env is git-ignored to prevent credential leakage.

# 1. PhishTank Developer API Key (Optional)
# Reduces IP-based rate limiting when fetching online-valid feeds.
# Register at: https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=

# 2. abuse.ch URLhaus Auth-Key (Required for URLhaus automated dumps)
# Keyless public exports have been retired (HTTP 410 Gone).
# Obtain a free community key at: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# 3. Zenodo Personal Access Token (Optional)
# Increases REST API rate limits for dataset metadata lookups.
# Generate at: https://zenodo.org/account/settings/applications/tokens/new/
ZENODO_ACCESS_TOKEN=
